---
import logo from "../../../app/src-tauri/icons/mesa.svg";
import github from "../assets/github.svg?raw";
import { CHANGELOG, GITHUB } from "../links";
---

<header class="header">
  <div class="container inner">
    <a class="brand" href="/">
      <img src={logo.src} alt="" width="30" height="26" />
      <span>Mesa</span>
    </a>
    <nav aria-label="Main">
      <a href={CHANGELOG}>Changelog</a>
      <a class="github" href={GITHUB}><span class="mark" aria-hidden="true" set:html={github} />GitHub</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid transparent;
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.5vw, 28px);
    font-size: 14px;
    font-weight: 500;
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  nav a:hover {
    color: var(--color-text);
  }

  .github {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mark {
    display: flex;
  }

  .mark :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
