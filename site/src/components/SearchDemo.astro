---
const WIDTH = 1080;
const HEIGHT = 635;
---

<div class="frame" data-demo style={`--demo-width: ${WIDTH}; --demo-height: ${HEIGHT}`}>
  <div class="scaled">
    <iframe src="/demo/" title="Mesa searching" tabindex="-1" aria-hidden="true" width={WIDTH} height={HEIGHT}></iframe>
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
</div>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const width = Number(getComputedStyle(frame).getPropertyValue("--demo-width"));
    new ResizeObserver(() => frame.style.setProperty("--scale", String(Math.min(1, frame.clientWidth / width)))).observe(frame);
  }
</script>

<style>
  .frame {
    -webkit-user-select: none;
    user-select: none;
    position: relative;
    width: 100%;
    max-width: calc(var(--demo-width) * 1px);
    margin: 0 auto;
    aspect-ratio: var(--demo-width) / var(--demo-height);
    border-radius: 14px;
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
  }

  .scaled {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--demo-width) * 1px);
    height: calc(var(--demo-height) * 1px);
    transform: scale(var(--scale, 1));
    transform-origin: 0 0;
  }

  iframe {
    -webkit-user-select: none;
    user-select: none;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }

  .lights {
    cursor: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 20 20'><circle cx='10' cy='10' r='7.6' fill='none' stroke='%23fff' stroke-width='4.4'/><path d='M4.6 15.4 L15.4 4.6' stroke='%23fff' stroke-width='4.4' stroke-linecap='round'/><circle cx='10' cy='10' r='7.6' fill='none' stroke='%23d6402f' stroke-width='2.2'/><path d='M4.6 15.4 L15.4 4.6' stroke='%23d6402f' stroke-width='2.2' stroke-linecap='round'/></svg>") 10 10, not-allowed;
    display: none;
    position: absolute;
    top: 9px;
    left: 13.5px;
    gap: 9px;
  }

  .lights i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  :global(:root[data-os="mac"]) .frame {
    border-radius: 12px;
    outline: 1px solid var(--color-border-strong);
    outline-offset: -1px;
  }

  :global(:root[data-os="mac"]) .lights {
    display: flex;
  }

  :global(:root[data-os="mac"][data-theme="dark"]) .frame {
    outline-color: rgba(0, 0, 0, 0.6);
  }

  :global(:root[data-os="mac"][data-theme="dark"]) .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.13);
    pointer-events: none;
  }
</style>
