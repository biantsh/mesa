---
import Icon from "./Icon.astro";

const SEARCHES = [
  {
    query: "receipt for the new tires",
    results: [
      { kind: "image", name: "IMG_4120.HEIC", reason: "Contains “tires”", detail: "" },
      { kind: "document", name: "Car expenses 2026.pdf", reason: "Closely matches your query", detail: "Best match on page 3" },
      { kind: "image", name: "Screenshot 2026-04-02.png", reason: "Closely matches your query", detail: "" },
    ],
  },
  {
    query: "dog running on the beach",
    results: [
      { kind: "video", name: "Holiday day 2.mov", reason: "Closely matches your query", detail: "Best match at 1:42" },
      { kind: "image", name: "DSC_0187.jpg", reason: "Closely matches your query", detail: "" },
      { kind: "image", name: "DSC_0191.jpg", reason: "Closely matches your query", detail: "" },
    ],
  },
  {
    query: "thunderstorm and heavy rain",
    results: [
      { kind: "audio", name: "Field recording 03.wav", reason: "Closely matches your query", detail: "Best match at 2:18" },
      { kind: "video", name: "From the balcony.mp4", reason: "Closely matches your query", detail: "Best match at 0:41" },
      { kind: "image", name: "IMG_3302.jpg", reason: "Loosely matches your query", detail: "" },
    ],
  },
  {
    query: "retry with exponential backoff",
    results: [
      { kind: "code", name: "client/http.rs", reason: "Closely matches your query", detail: "" },
      { kind: "code", name: "sync/queue.ts", reason: "Closely matches your query", detail: "" },
      { kind: "document", name: "Architecture.md", reason: "Contains “backoff”", detail: "" },
    ],
  },
] as const;
---

<div class="window" aria-label="A search in Mesa" role="img">
  <div class="bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="body">
    <div class="field">
      <Icon name="search" size={18} class="lens" />
      <span class="query" data-query>{SEARCHES[0].query}</span><span class="caret"></span>
    </div>
    <div class="stack">
      {
        SEARCHES.map((search, i) => (
          <ul class="results" data-results={i} data-shown={i === 0 ? "" : undefined}>
            {search.results.map((result) => (
              <li class="result">
                <div class:list={["preview", result.kind]}>
                  <Icon name={result.kind} size={26} />
                </div>
                <div class="text">
                  <span class="name">{result.name}</span>
                  <span class="reason">{result.reason}</span>
                  {result.detail && <span class="detail">{result.detail}</span>}
                </div>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<script define:vars={{ queries: SEARCHES.map((search) => search.query) }}>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const field = document.querySelector("[data-query]");
  const lists = [...document.querySelectorAll("[data-results]")];
  const wait = (ms) => new Promise((done) => setTimeout(done, ms));

  async function run() {
    let at = 0;
    for (;;) {
      await wait(3600);
      const text = field.textContent;
      for (let i = text.length; i >= 0; i--) {
        field.textContent = text.slice(0, i);
        await wait(18);
      }
      lists[at].removeAttribute("data-shown");
      at = (at + 1) % queries.length;
      await wait(250);
      for (let i = 1; i <= queries[at].length; i++) {
        field.textContent = queries[at].slice(0, i);
        await wait(45 + Math.random() * 40);
      }
      await wait(300);
      lists[at].setAttribute("data-shown", "");
    }
  }

  if (!still && field) run();
</script>

<style>
  .window {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--window-radius, 14px);
    background: var(--color-bg);
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
  }

  .bar {
    display: flex;
    gap: 8px;
    padding: 14px 16px 0;
  }

  .bar span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .body {
    padding: 28px clamp(16px, 5vw, 56px) 40px;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-field);
    font-size: 16px;
  }

  .field :global(.lens) {
    flex: none;
    color: var(--color-text-muted);
  }

  .query {
    white-space: nowrap;
    overflow: hidden;
  }

  .caret {
    flex: none;
    width: 2px;
    height: 20px;
    margin-left: 1px;
    background: var(--color-primary);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .stack {
    display: grid;
    margin-top: 24px;
  }

  .results {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: start;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results:not([data-shown]) {
    visibility: hidden;
  }

  .results:not([data-shown]) .result {
    animation: none;
  }

  .result {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow: hidden;
    animation: arrive 360ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  .result:nth-child(2) {
    animation-delay: 60ms;
  }

  .result:nth-child(3) {
    animation-delay: 120ms;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--color-preview-bg);
    color: var(--color-file);
  }

  .preview.image {
    background: linear-gradient(160deg, #fdbd64, #e26931 70%, #a33930);
    color: rgba(255, 255, 255, 0.85);
  }

  .preview.video {
    background: linear-gradient(160deg, #6f8fb0, #2f4a66);
    color: rgba(255, 255, 255, 0.85);
  }

  .preview.audio {
    color: var(--color-primary);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px 12px;
    min-width: 0;
  }

  .name {
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reason {
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .detail {
    color: var(--color-primary-ink);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .results {
      grid-template-columns: minmax(0, 1fr);
    }

    .result {
      flex-direction: row;
    }

    .preview {
      flex: none;
      width: 88px;
      aspect-ratio: auto;
    }
  }
</style>
