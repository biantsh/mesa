---
const WIDTH = 1080;
const HEIGHT = 635;
---

<div class="frame" data-demo style={`--demo-width: ${WIDTH}; --demo-height: ${HEIGHT}`}>
  <div class="scaled">
    <iframe src="/demo/" title="Mesa searching" tabindex="-1" aria-hidden="true" inert width={WIDTH} height={HEIGHT}></iframe>
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
  <div class="glass" aria-hidden="true">
    <span class="paused">
      <span class="what">This is the app’s actual code, running live in your browser</span>
      <span class="state">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect x="1.5" y="1" width="2.5" height="8" rx="0.75" /><rect x="6" y="1" width="2.5" height="8" rx="0.75" /></svg>
        <strong>Paused</strong> · Unhover to resume
      </span>
    </span>
  </div>
</div>

<script is:inline>
  (() => {
    for (const frame of document.querySelectorAll("[data-demo]:not([data-scaled])")) {
      frame.dataset.scaled = "";
      const width = Number(getComputedStyle(frame).getPropertyValue("--demo-width"));
      const scale = () => frame.style.setProperty("--scale", String(Math.min(1, frame.clientWidth / width)));
      scale();
      new ResizeObserver(scale).observe(frame);

      const demo = frame.querySelector("iframe");
      const loaded = () => {
        try {
          return demo.contentWindow.location.pathname.startsWith("/demo");
        } catch {
          return true;
        }
      };
      const show = () => {
        if (loaded()) frame.dataset.loaded = "";
      };
      demo.addEventListener("load", show);
      show();
    }
  })();
</script>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const glass = frame.querySelector<HTMLElement>(".glass");
    const demo = frame.querySelector("iframe");
    if (!glass || !demo) continue;
    const tell = (here: boolean) => demo.contentWindow?.postMessage({ type: "mesa-demo-visitor", here }, location.origin);
    let here = false;
    const comeIn = () => {
      if (here) return;
      here = true;
      frame.toggleAttribute("data-paused", true);
      tell(true);
    };

    const SCROLLING_MS = 450;
    const MOVED_PX = 2;
    let scrolledAt = -Infinity;
    let travelled = 0;
    let last: { x: number; y: number } | null = null;
    const cancel = () => {
      travelled = 0;
      last = null;
    };
    glass.addEventListener("pointermove", (event) => {
      if (here || event.pointerType === "touch") return;
      if (performance.now() - scrolledAt < SCROLLING_MS) return cancel();
      travelled += last ? Math.hypot(event.screenX - last.x, event.screenY - last.y) : Math.hypot(event.movementX, event.movementY);
      last = { x: event.screenX, y: event.screenY };
      if (travelled >= MOVED_PX) comeIn();
    });
    window.addEventListener(
      "wheel",
      () => {
        if (here) return;
        scrolledAt = performance.now();
        cancel();
      },
      { passive: true },
    );
    for (const type of ["focus", "blur"]) window.addEventListener(type, cancel);
    document.addEventListener("visibilitychange", cancel);

    glass.addEventListener("pointerleave", () => {
      cancel();
      if (!here) return;
      here = false;
      frame.toggleAttribute("data-paused", false);
      tell(false);
    });
    glass.addEventListener("pointerdown", (event) => event.pointerType !== "touch" && comeIn());
    glass.addEventListener("dragover", (event) => {
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = "none";
    });
    glass.addEventListener("drop", (event) => event.preventDefault());
    window.addEventListener("message", (event) => {
      if (here && event.source === demo.contentWindow && event.data?.type === "mesa-demo-playing") tell(true);
    });
  }
</script>

<style>
  .frame {
    -webkit-user-select: none;
    user-select: none;
    position: relative;
    width: 100%;
    max-width: calc(var(--demo-width) * 1px);
    margin: 0 auto;
    aspect-ratio: var(--demo-width) / var(--demo-height);
    border-radius: calc(14px * var(--scale, 1));
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
    background: var(--color-bg);
  }

  .scaled {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--demo-width) * 1px);
    height: calc(var(--demo-height) * 1px);
    transform: scale(var(--scale, 1));
    transform-origin: 0 0;
  }

  iframe {
    -webkit-user-select: none;
    user-select: none;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  .frame[data-loaded] iframe {
    opacity: 1;
  }

  .glass {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    justify-items: center;
    align-items: end;
    padding-bottom: 8px;
    cursor: default;
  }

  .paused {
    --s: max(0.78, var(--scale, 1));
    display: grid;
    justify-items: center;
    gap: calc(3px * var(--s));
    max-width: calc(100% - 32px);
    padding: calc(8px * var(--s)) calc(18px * var(--s));
    border: 1px solid var(--color-border-strong);
    border-radius: calc(12px * var(--s));
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-dialog);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 120ms ease-in,
      transform 150ms ease-in;
  }

  .paused .what {
    color: var(--color-text);
    font-size: calc(14px * var(--s));
    font-weight: 600;
    line-height: 1.35;
  }

  .paused .state {
    display: flex;
    align-items: center;
    gap: calc(6px * var(--s));
    color: var(--color-text-muted);
    font-size: calc(13px * var(--s));
    line-height: 1.35;
  }

  .paused .state svg {
    flex: none;
    fill: currentColor;
  }

  .paused .state strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .frame[data-paused] .paused {
    opacity: 1;
    transform: none;
    transition:
      opacity 160ms ease-out,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .paused,
    .frame[data-paused] .paused {
      transform: none;
      transition-duration: 0s;
    }
  }

  .lights {
    pointer-events: none;
    display: none;
    position: absolute;
    top: 9px;
    left: 13.5px;
    gap: 9px;
  }

  .lights i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  :global(:root[data-os="mac"]) .frame {
    border-radius: calc(12px * var(--scale, 1));
    outline: 1px solid var(--color-border-strong);
    outline-offset: -1px;
  }

  :global(:root[data-os="mac"]) .lights {
    display: flex;
  }

  :global(:root[data-os="mac"][data-theme="dark"]) .frame {
    outline-color: rgba(0, 0, 0, 0.6);
  }

  :global(:root[data-os="mac"][data-theme="dark"]) .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.13);
    pointer-events: none;
  }
</style>
