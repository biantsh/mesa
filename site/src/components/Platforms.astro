---
import Icon from "./Icon.astro";
import { PLATFORMS } from "../platforms";
---

<ul class="platforms">
  {
    PLATFORMS.map((platform) => (
      <li class="platform" data-id={platform.id}>
        <div class="head">
          <span class="logo" set:html={platform.logo} />
          <h3>{platform.name}</h3>
          <span class="mine">Your system</span>
        </div>
        <p class="needs">{platform.needs}</p>
        <div class="group">
          {platform.installers.map((kind) => (
            <button type="button" class="button installer">
              <Icon name="download" size={16} />
              {platform.installers.length === 1 ? (
                <span>
                  Download <span class="kind">{kind}</span>
                </span>
              ) : (
                <span class="kind">{kind}</span>
              )}
            </button>
          ))}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platform {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo {
    display: grid;
    width: 24px;
    height: 24px;
    color: var(--color-text);
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  h3 {
    font-size: 18px;
  }

  .mine {
    display: none;
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-selected-bg);
    color: var(--color-primary-ink);
    font-size: 12px;
    font-weight: 600;
  }

  .needs {
    margin: 10px 0 20px;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .installer {
    flex: 1 1 auto;
    gap: 6px;
    padding: 0 10px;
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .installer:hover {
    background: var(--color-neutral);
  }

  .kind {
    font-weight: 600;
  }

  :global(:root[data-os="mac"]) .platform[data-id="mac"],
  :global(:root[data-os="windows"]) .platform[data-id="windows"],
  :global(:root[data-os="linux"]) .platform[data-id="linux"] {
    border-color: var(--color-primary);
  }

  :global(:root[data-os="mac"]) [data-id="mac"] .mine,
  :global(:root[data-os="windows"]) [data-id="windows"] .mine,
  :global(:root[data-os="linux"]) [data-id="linux"] .mine {
    display: inline-block;
  }

  :global(:root[data-os="mac"]) [data-id="mac"] .installer,
  :global(:root[data-os="windows"]) [data-id="windows"] .installer,
  :global(:root[data-os="linux"]) [data-id="linux"] .installer {
    border-color: transparent;
    background: var(--gradient-primary), var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-primary);
  }

  :global(:root[data-os="linux"]) [data-id="linux"] .installer + .installer {
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.32), var(--shadow-primary);
  }

  :global(:root[data-os="mac"]) [data-id="mac"] .installer:hover,
  :global(:root[data-os="windows"]) [data-id="windows"] .installer:hover,
  :global(:root[data-os="linux"]) [data-id="linux"] .installer:hover {
    background-color: var(--color-primary-hover);
  }
</style>
