---
import "@fontsource-variable/inter";
import "../../../app/src/styles/tokens.css";
import "../styles/site.css";
import logo from "../../../app/src-tauri/icons/mesa.svg";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const preview = Astro.site && new URL("/preview.png", Astro.site).href;
const address = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {address && <meta property="og:url" content={address} />}
    {address && <link rel="canonical" href={address} />}
    {preview && <meta property="og:image" content={preview} />}
    {preview && <meta property="og:image:width" content="1200" />}
    {preview && <meta property="og:image:height" content="630" />}
    {preview && <meta property="og:image:alt" content="Mesa searching a folder of photos for a dog at the beach" />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const KEY = "mesa.theme";
        const root = document.documentElement;
        const dark = window.matchMedia("(prefers-color-scheme: dark)");
        const kept = () => {
          try {
            const theme = localStorage.getItem(KEY);
            return theme === "light" || theme === "dark" ? theme : null;
          } catch {
            return null;
          }
        };
        const system = () => (dark.matches ? "dark" : "light");
        const mark = () => {
          const now = root.dataset.theme || "light";
          for (const option of document.querySelectorAll("[data-theme-option]")) {
            const on = option.dataset.themeOption === now;
            option.setAttribute("aria-checked", String(on));
            option.tabIndex = on ? 0 : -1;
          }
        };
        let settling;
        const apply = (theme, quietly) => {
          if ((root.dataset.theme || "light") !== theme) {
            if (quietly) {
              root.dataset.themeChanging = "";
              clearTimeout(settling);
              settling = setTimeout(() => delete root.dataset.themeChanging, 350);
            }
            if (theme === "dark") root.dataset.theme = "dark";
            else delete root.dataset.theme;
          }
          mark();
        };
        const pick = (theme) => {
          try {
            localStorage.setItem(KEY, theme);
          } catch {}
          apply(theme, true);
        };
        apply(kept() || system(), false);
        document.addEventListener("DOMContentLoaded", mark);
        dark.addEventListener("change", () => {
          if (!kept()) apply(system(), true);
        });
        document.addEventListener("click", (event) => {
          const option = event.target instanceof Element && event.target.closest("[data-theme-option]");
          if (option) pick(option.dataset.themeOption);
        });
        document.addEventListener("keydown", (event) => {
          const option = event.target instanceof Element && event.target.closest("[data-theme-option]");
          const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
          if (!option || !step) return;
          event.preventDefault();
          const options = [...option.parentElement.querySelectorAll("[data-theme-option]")];
          const next = options[(options.indexOf(option) + step + options.length) % options.length];
          pick(next.dataset.themeOption);
          next.focus();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const asked = new URLSearchParams(location.search).get("os");
        const hint = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.userAgent).toLowerCase();
        const os = ["mac", "windows", "linux"].includes(asked)
          ? asked
          : hint.includes("win")
            ? "windows"
            : hint.includes("linux") && !hint.includes("android")
              ? "linux"
              : "mac";
        const agent = navigator.userAgent.toLowerCase();
        const handheld =
          (navigator.userAgentData && navigator.userAgentData.mobile) ||
          /android|iphone|ipad|ipod/.test(agent) ||
          (agent.includes("macintosh") && navigator.maxTouchPoints > 1);
        document.documentElement.dataset.os = os;
        if (asked === os || !handheld) document.documentElement.dataset.mine = os;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
