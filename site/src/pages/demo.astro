---
import "@fontsource-variable/inter";
import "../../../app/src/styles/tokens.css";
import "../../../app/src/styles/global.css";
import DemoApp from "../demo/DemoApp";
import DemoShell from "../demo/DemoShell";
import logo from "../demo/logo";
import appStyles from "../../../app/src/App.module.css";

const app = `#root .${appStyles.window}`;
const border = `
  ${app} {
    border-color: transparent;
  }
  #demo-border {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    border: var(--window-border) solid var(--color-border-strong);
    border-radius: var(--window-radius);
    transition: border-color 360ms ease;
  }
  :root:has(${app}.${appStyles.dimmedWindow}) #demo-border {
    border-color: var(--color-border-strong-dimmed);
  }
  @keyframes demo-in {
    from {
      opacity: 0;
    }
  }
  @keyframes demo-in-fade {
    from {
      --screen-fade: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    ${app} .${appStyles.pane} {
      animation: demo-in 450ms ease-out;
    }
    :root[data-engine="webkitgtk"] ${app} .${appStyles.pane} {
      animation-name: demo-in-fade;
    }
  }
`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Mesa</title>
    <link rel="preload" href={logo} as="image" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let site = null;
        try {
          if (window.parent !== window) site = window.parent.document.documentElement;
        } catch {}
        const dark = site ? site.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "dark" : "light";
        const name = navigator.platform || navigator.userAgent;
        const os = (site && site.dataset.os) || (/Mac/i.test(name) ? "mac" : /Linux/i.test(name) ? "linux" : "windows");
        if (os !== "windows") root.dataset.platform = os;
        const agent = navigator.userAgent;
        if (/Linux/.test(agent) && /AppleWebKit/.test(agent) && !/Chrome|Chromium|Edg\//.test(agent)) root.dataset.engine = "webkitgtk";
      })();
    </script>
    <style is:inline>
      :root {
        color-scheme: light;
        background: transparent;
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
      }
      #demo-shell {
        position: fixed;
        inset: 0;
        z-index: 2147483000;
      }
      #demo-shell footer {
        will-change: opacity;
      }
      :root[data-platform="mac"] #demo-shell > [data-shell="other"],
      :root:not([data-platform="mac"]) #demo-shell > [data-shell="mac"] {
        display: none;
      }
    </style>
    <style is:inline set:html={border} />
  </head>
  <body>
    <div id="root">
      <DemoApp client:only="react" />
    </div>
    <div id="demo-border" aria-hidden="true"></div>
    <div id="demo-shell" aria-hidden="true" inert>
      <DemoShell />
    </div>
  </body>
</html>
