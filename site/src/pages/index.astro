---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Download from "../components/Download.astro";
import Platforms from "../components/Platforms.astro";
import SearchDemo from "../components/SearchDemo.astro";
import DemoScenarios from "../components/DemoScenarios";
import Icon, { type IconName } from "../components/Icon.astro";
import { releaseLine } from "../release";
import { LICENSE, LICENSE_NAME } from "../links";

const FEATURES: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "sparkles",
    title: "Search by meaning",
    text: "Describe what a file shows, says or sounds like.",
  },
  {
    icon: "scanSearch",
    title: "Drop to search",
    text: "Drop a photo, song or file to find similar ones.",
  },
  {
    icon: "pictureInPicture",
    title: "Open anywhere",
    text: "Open a quick search window with a shortcut.",
  },
];

const KINDS: { icon: IconName; name: string; lines: [string, string] }[] = [
  { icon: "document", name: "Documents", lines: ["Text, sheets, slides,", "PDFs and books"] },
  { icon: "image", name: "Images", lines: ["Photos, screenshots,", "scans and graphics"] },
  { icon: "video", name: "Videos", lines: ["Recordings, movies,", "clips and screen captures"] },
  { icon: "audio", name: "Audio", lines: ["Podcasts, audiobooks,", "music and sound effects"] },
  { icon: "code", name: "Code", lines: ["Python, TypeScript, Go,", "C++ and 50+ more"] },
];

const description = "Find anything in your files using any combination of clues: text, images, sounds, dates, and more. Private, on your computer.";
---

<Base title="Mesa: find anything in your files" description={description}>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-row">
        <div class="hero-text">
          <h1>Find anything in your&nbsp;files</h1>
          <p class="hero-lead">
            Search your documents, pictures, videos, recordings and code by what they say, show or sound like.
          </p>
        </div>
        <Download end />
      </div>
      <div class="container demo">
        <div class="demo-window">
          <SearchDemo />
          <div class="demo-below">
            <DemoScenarios client:load />
            <div class="demo-caption">
              <p><strong>Interactive demo</strong><span class="by-pointer">: hover to take over</span></p>
              <span class="about" data-about>
                <button class="about-button" type="button" aria-label="About this demo" aria-describedby="demo-about" aria-expanded="false">
                  <Icon name="info" size={15} />
                </button>
                <span class="about-text" id="demo-about" role="tooltip">
                  <span><strong>This is Mesa’s real code</strong>, running live in your browser using sample files.</span>
                  <span>
                    <strong>Typing is turned off</strong>: searches need a 310&nbsp;MB model, which runs on your computer.
                  </span>
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="rest">
    <section class="section" id="features">
      <div class="container">
        <h2 class="section-title">Features</h2>
        <ul class="features">
          {
            FEATURES.map((feature) => (
              <li class="feature">
                <span class="feature-icon">
                  <Icon name={feature.icon} size={18} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))
          }
        </ul>
        <ul class="kinds">
          {
            KINDS.map((kind) => (
              <li class="kind">
                <Icon name={kind.icon} size={22} />
                <strong>{kind.name}</strong>
                <span>{kind.lines[0]}<br />{kind.lines[1]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="privacy">
      <div class="container">
        <h2 class="section-title">Privacy</h2>
        <div class="privacy">
          <span class="privacy-icon"><Icon name="lock" size={24} /></span>
          <p class="lead">
            Mesa runs on your own machine. There’s no account and no cloud.{" "}<br class="wide-only" />
            After setup, it works without an internet connection.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="download">
      <div class="container download-inner">
        <h2 class="section-title">Download</h2>
        <Platforms />
        <p class="release">
          <a class="license" href={LICENSE}>{LICENSE_NAME}</a><span class="separator" aria-hidden="true"></span>{releaseLine()}
        </p>
      </div>
    </section>
    </div>
  </main>

</Base>

<style>
  .hero {
    --hero-room: clamp(24px, (100svh - var(--header-height) - 842px) / 2, 56px);
    padding-top: min(clamp(40px, 4vw, 56px), var(--hero-room));
    padding-bottom: calc(40px + var(--hero-room));
  }

  @media (max-width: 760px) {
    .hero {
      padding-bottom: var(--section-space);
    }
  }

  .hero,
  .rest {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-height));
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: var(--content-width);
    margin-inline: auto;
  }

  @media (min-width: 1080px) {
    .hero-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
    }
  }

  .hero-text {
    min-width: 0;
  }

  h1 {
    font-size: clamp(36px, 4.6vw, 52px);
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .hero-lead {
    max-width: 540px;
    margin: 14px 0 0;
    color: var(--color-text-muted);
    font-size: clamp(16px, 1.7vw, 18px);
  }

  .demo {
    margin-top: clamp(28px, 3vw, 36px);
  }

  .demo-window {
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
    container-type: inline-size;
  }

  @media (min-width: 1080px) {
    .demo-window {
      max-width: min(1080px, max(648px, (100svh - 320px) * 1080 / 635));
    }
  }

  .demo-caption {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: 13px;
    white-space: nowrap;
  }

  .demo-below {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 12px;
  }

  @media (max-width: 760px) {
    .demo-below {
      position: static;
      flex-direction: column;
      align-items: flex-start;
      margin-top: 16px;
    }
  }

  .demo-caption p {
    margin: 0;
  }

  .demo-caption strong {
    color: var(--color-text);
    font-weight: 500;
  }

  .about {
    position: relative;
    display: flex;
  }

  .about-button {
    display: flex;
    padding: 2px;
    margin: -2px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text-muted);
    cursor: help;
    transition: color 150ms ease;
  }

  .about-button:hover,
  .about-button:focus-visible,
  [data-open] > .about-button {
    color: var(--color-text);
  }

  .about-text {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    z-index: 5;
    display: grid;
    gap: 8px;
    width: 312px;
    max-width: calc(100vw - 32px);
    padding: 10px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    box-shadow: var(--shadow-menu);
    font-size: 13px;
    line-height: 1.45;
    white-space: normal;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px) scale(0.97);
    transform-origin: calc(100% - 7px) bottom;
    transition:
      opacity 80ms ease-in,
      transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s 150ms;
  }

  .about:has(.about-button:hover) .about-text,
  .about:has(.about-button:focus-visible) .about-text,
  .about[data-open] .about-text {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 150ms ease-out,
      transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .by-pointer {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .by-pointer {
      display: inline;
    }
  }

  @container (max-width: 689px) {
    .by-pointer {
      display: none;
    }
  }

  #features {
    padding-top: calc(var(--section-space) * 0.5);
  }

  #download {
    padding-bottom: calc(var(--section-space) * 0.5 + 26px);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px 40px;
    margin: var(--heading-space) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1200px) {
    .features {
      display: flex;
      justify-content: space-between;
    }
  }

  .feature,
  .kind {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    align-content: start;
  }

  .feature {
    column-gap: 12px;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--color-hover-bg);
    color: var(--color-primary-ink);
  }

  .feature h3 {
    font-size: 17px;
  }

  .feature p {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px 20px;
    margin: calc(var(--section-space) * 0.5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1200px) {
    .kinds {
      display: flex;
      justify-content: space-between;
    }
  }

  .kind {
    gap: 6px 10px;
  }

  .kind :global(svg) {
    color: var(--color-primary-ink);
  }

  .kind span {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-size: 14px;
    text-box: trim-end cap alphabetic;
  }

  #privacy {
    padding-block: calc(var(--section-space) * 0.5);
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: var(--heading-space);
  }

  .privacy .lead {
    margin: 0;
  }

  @media (max-width: 760px) {
    .wide-only {
      display: none;
    }
  }

  .privacy-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-primary);
  }

  .download-inner > :global(.platforms) {
    margin-top: var(--heading-space);
  }

  .release {
    margin: calc(var(--heading-space) * 0.5) 0 0;
    color: var(--color-text-muted);
    font-size: 14px;
    text-box: trim-both cap alphabetic;
  }

  .license {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease;
  }

  .license:hover {
    text-decoration-color: currentColor;
  }
</style>

<script>
  for (const about of document.querySelectorAll<HTMLElement>("[data-about]")) {
    const button = about.querySelector("button")!;
    let touched = false;
    const set = (open: boolean) => {
      about.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
    };
    button.addEventListener("pointerdown", (event) => (touched = event.pointerType !== "mouse"));
    button.addEventListener("click", () => touched && set(!about.hasAttribute("data-open")));
    document.addEventListener("pointerdown", (event) => !about.contains(event.target as Node) && set(false));
    document.addEventListener("keydown", (event) => event.key === "Escape" && set(false));
  }
</script>
