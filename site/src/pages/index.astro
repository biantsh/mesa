---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Download from "../components/Download.astro";
import Platforms from "../components/Platforms.astro";
import SearchDemo from "../components/SearchDemo.astro";
import DemoScenarios from "../components/DemoScenarios";
import Icon, { type IconName } from "../components/Icon.astro";
import { releaseLine } from "../release";
import { CHANGELOG, LICENSE, LICENSE_NAME } from "../links";

const FEATURES: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "sparkles",
    title: "Search by meaning",
    text: "Describe what a file shows, says or sounds like.",
  },
  {
    icon: "scanSearch",
    title: "Drop to search",
    text: "Drop a photo, song or file to find similar ones.",
  },
  {
    icon: "pictureInPicture",
    title: "Open anywhere",
    text: "Open a quick search window with a shortcut.",
  },
];

const KINDS: { icon: IconName; name: string; lines: [string, string] }[] = [
  { icon: "document", name: "Documents", lines: ["Text, sheets, slides,", "PDFs and books"] },
  { icon: "image", name: "Images", lines: ["Photos, screenshots,", "scans and graphics"] },
  { icon: "video", name: "Videos", lines: ["Recordings, movies,", "clips and screen captures"] },
  { icon: "audio", name: "Audio", lines: ["Podcasts, audiobooks,", "music and sound effects"] },
  { icon: "code", name: "Code", lines: ["Python, TypeScript, Go,", "C++ and 50+ more"] },
];

const description = "Find anything in your files using any combination of clues: text, images, sounds, dates, and more. Private, on your computer.";
---

<Base title="Mesa: find anything in your files" description={description}>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-row">
        <h1>Find anything in your&nbsp;files</h1>
        <div class="hero-under">
          <p class="hero-lead">
            Search your documents, pictures, videos, recordings and code by what they say, show or sound like.
          </p>
          <span class="hero-separator" aria-hidden="true"></span>
          <Download end />
        </div>
      </div>
      <div class="container demo">
        <div class="demo-window">
          <SearchDemo />
          <div class="demo-below">
            <DemoScenarios client:load />
            <p class="demo-note">This is the app’s actual code, running live in your browser using sample files.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="rest">
    <section class="section" id="features">
      <div class="container">
        <h2 class="section-title">Features</h2>
        <ul class="features">
          {
            FEATURES.map((feature) => (
              <li class="feature">
                <span class="feature-icon">
                  <Icon name={feature.icon} size={18} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))
          }
        </ul>
        <ul class="kinds">
          {
            KINDS.map((kind) => (
              <li class="kind">
                <Icon name={kind.icon} size={22} />
                <strong>{kind.name}</strong>
                <span>{kind.lines[0]}<br />{kind.lines[1]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="privacy">
      <div class="container">
        <h2 class="section-title">Privacy</h2>
        <div class="privacy">
          <span class="privacy-icon"><Icon name="lock" size={24} /></span>
          <p class="lead">
            Mesa runs on your own machine. There’s no account and no cloud.{" "}<br class="wide-only" />
            After setup, it works without an internet connection.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="download">
      <div class="container download-inner">
        <h2 class="section-title">Download</h2>
        <Platforms />
        <p class="release">
          <a class="quiet" href={LICENSE}>{LICENSE_NAME}</a><span class="separator" aria-hidden="true"></span><a class="quiet" href={CHANGELOG}>{releaseLine()}</a>
        </p>
      </div>
    </section>
    <div class="rest-end" aria-hidden="true"></div>
    </div>
  </main>

</Base>

<style>
  .hero {
    --text-height: 145px;
    --window-gap: clamp(24px, 2vw, 32px);
    --switches-gap: 18px;
    --note: 0px;
    --window-height: min(635px, max(381px, 100svh - 324px - var(--note)));
    --free: calc(100svh - var(--header-height) - var(--text-height) - var(--window-gap) - var(--window-height) - var(--switches-gap) - 32px - var(--note));
    --room-below: clamp(24px, var(--free) / 2, 56px);
    --room-above: clamp(12px, var(--free) - var(--room-below), 56px);
    padding-top: min(clamp(40px, 4vw, 56px), var(--room-above));
    padding-bottom: calc(var(--switches-gap) + 32px + var(--note) + var(--room-below));
  }

  @media (pointer: coarse) {
    .hero {
      --note: 32px;
    }
  }

  @media (min-width: 1080px) and (max-height: 1000px) {
    .hero {
      --window-gap: 24px;
      --switches-gap: 12px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-bottom: var(--section-space);
    }
  }

  .hero,
  .rest {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-height));
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: var(--content-width);
    margin-inline: auto;
    text-align: center;
  }

  .hero-under {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .hero-separator {
    display: none;
  }

  @media (min-width: 1080px) {
    .hero-row {
      gap: 18px;
    }

    .hero-under {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: 28px;
    }

    .hero-under .hero-lead {
      max-width: 600px;
      margin-top: 6px;
      text-align: left;
      font-size: 20px;
      line-height: 30px;
    }

    .hero-under .hero-separator {
      display: block;
      align-self: stretch;
      width: 1px;
      background: var(--color-border-strong);
    }
  }

  h1 {
    font-size: clamp(36px, 4.6vw, 52px);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-lead {
    max-width: 540px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(16px, 1.7vw, 18px);
  }

  .demo {
    margin-top: var(--window-gap);
  }

  .demo-window {
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
  }

  @media (min-width: 1080px) {
    .demo-window {
      max-width: calc(var(--window-height) * 1080 / 635);
    }
  }

  .demo-below {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin-top: var(--switches-gap);
  }

  .demo-below :global([role="radiogroup"]) {
    grid-column: 2;
  }

  .demo-below :global([role="radiogroup"] > button) {
    height: 30px;
    padding: 0 14px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .demo-below {
      position: static;
    }
  }

  @media (max-width: 1079px) {
    .hero {
      --text-height: 217px;
      --window-gap: 36px;
      --switches-gap: 20px;
    }

  }

  .demo-note {
    display: none;
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.45;
    text-align: center;
  }

  @media (pointer: coarse) {
    .demo-note {
      display: block;
    }
  }

  #features {
    padding-top: calc(var(--section-space) * 0.5);
  }

  #download {
    padding-bottom: 0;
  }

  .rest-end {
    --end-space: calc(var(--section-space) * 0.5 + 26px);
    flex: 1 0 auto;
    min-height: calc(var(--section-space) * 0.3);
    max-height: var(--end-space);
  }

  @media (max-width: 760px) {
    .rest-end {
      min-height: var(--end-space);
    }
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px 40px;
    margin: var(--heading-space) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1200px) {
    .features {
      display: flex;
      justify-content: space-between;
    }
  }

  .feature,
  .kind {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    align-content: start;
  }

  .feature {
    column-gap: 12px;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--color-hover-bg);
    color: var(--color-primary-ink);
  }

  .feature h3 {
    font-size: 17px;
  }

  .feature p {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px 20px;
    margin: calc(var(--section-space) * 0.5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 520px) {
    .kinds {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }

  @media (max-width: 679px) {
    .kinds {
      margin-top: var(--section-space);
    }
  }

  @media (min-width: 1200px) {
    .kinds {
      display: flex;
      justify-content: space-between;
    }
  }

  .kind {
    gap: 6px 10px;
  }

  .kind :global(svg) {
    color: var(--color-primary-ink);
  }

  .kind span {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-size: 14px;
    text-box: trim-end cap alphabetic;
  }

  #privacy {
    padding-block: calc(var(--section-space) * 0.5);
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: var(--heading-space);
  }

  .privacy .lead {
    margin: 0;
  }

  @media (max-width: 760px) {
    .wide-only {
      display: none;
    }

    .privacy .lead {
      font-size: 16px;
    }
  }

  .privacy-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-primary);
  }

  .download-inner > :global(.platforms) {
    margin-top: var(--heading-space);
  }

  .release {
    margin: calc(var(--heading-space) * 0.5) 0 0;
    color: var(--color-text-muted);
    font-size: 14px;
    text-box: trim-both cap alphabetic;
  }

  .quiet {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease;
  }

  .quiet:hover {
    text-decoration-color: currentColor;
  }
</style>
