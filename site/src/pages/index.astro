---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Download from "../components/Download.astro";
import Platforms from "../components/Platforms.astro";
import SearchDemo from "../components/SearchDemo.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import { releaseLine } from "../release";
import { LICENSE, LICENSE_NAME } from "../links";

const FEATURES: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "sparkles",
    title: "Search by meaning",
    text: "Describe what a file shows, says or sounds like.",
  },
  {
    icon: "scanSearch",
    title: "Drop to search",
    text: "Drop a photo, song or file to find similar ones.",
  },
  {
    icon: "pictureInPicture",
    title: "Open anywhere",
    text: "Open a quick search window with a shortcut.",
  },
];

const KINDS: { icon: IconName; name: string; lines: [string, string] }[] = [
  { icon: "document", name: "Documents", lines: ["Text, sheets, slides,", "PDFs and books"] },
  { icon: "image", name: "Images", lines: ["Photos, screenshots,", "scans and graphics"] },
  { icon: "video", name: "Videos", lines: ["Recordings, movies,", "clips and screen captures"] },
  { icon: "audio", name: "Audio", lines: ["Podcasts, audiobooks,", "music and sound effects"] },
  { icon: "code", name: "Code", lines: ["Python, TypeScript, Go,", "C++ and 50+ more"] },
];

const description = "Find anything in your files using any combination of clues: text, images, sounds, dates, and more. Private, on your computer.";
---

<Base title="Mesa: find anything in your files" description={description}>
  <Header />

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <h1>Find anything in your&nbsp;files</h1>
        <p class="hero-lead">
          Search your documents, pictures, videos, recordings and code by what they say, show or sound like.
        </p>
        <Download />
      </div>
      <div class="container demo">
        <SearchDemo />
      </div>
    </section>

    <div class="rest">
    <section class="section" id="features">
      <div class="container">
        <h2 class="section-title">Features</h2>
        <ul class="features">
          {
            FEATURES.map((feature) => (
              <li class="feature">
                <span class="feature-icon">
                  <Icon name={feature.icon} size={18} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))
          }
        </ul>
        <ul class="kinds">
          {
            KINDS.map((kind) => (
              <li class="kind">
                <Icon name={kind.icon} size={22} />
                <strong>{kind.name}</strong>
                <span>{kind.lines[0]}<br />{kind.lines[1]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="privacy">
      <div class="container">
        <h2 class="section-title">Privacy</h2>
        <div class="privacy">
          <span class="privacy-icon"><Icon name="lock" size={24} /></span>
          <p class="lead">
            Mesa runs on your own machine. There’s no account and no cloud.{" "}<br class="wide-only" />
            After setup, it works without an internet connection.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="download">
      <div class="container download-inner">
        <h2 class="section-title">Download</h2>
        <Platforms />
        <p class="release">
          <a class="license" href={LICENSE}>{LICENSE_NAME}</a><span class="separator" aria-hidden="true"></span>{releaseLine()}
        </p>
      </div>
    </section>
    </div>
  </main>

</Base>

<style>
  .hero {
    padding-top: clamp(56px, 9vw, 104px);
    padding-bottom: max(var(--section-space), 88px);
  }

  .hero,
  .rest {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-height));
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .hero-lead {
    max-width: 600px;
    margin: 20px 0 32px;
    color: var(--color-text-muted);
    font-size: clamp(17px, 2vw, 20px);
  }

  .demo {
    margin-top: clamp(48px, 7vw, 72px);
  }

  #features {
    padding-top: calc(var(--section-space) * 0.5);
  }

  #download {
    padding-bottom: calc(var(--section-space) * 0.6);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px 40px;
    margin: var(--heading-space) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1200px) {
    .features {
      display: flex;
      justify-content: space-between;
    }
  }

  .feature,
  .kind {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  .feature,
  .kind {
    align-content: start;
  }

  .feature {
    column-gap: 12px;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--color-hover-bg);
    color: var(--color-primary-ink);
  }

  .feature h3 {
    font-size: 17px;
  }

  .feature p {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px 20px;
    margin: calc(var(--section-space) * 0.5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1200px) {
    .kinds {
      display: flex;
      justify-content: space-between;
    }
  }

  .kind {
    gap: 6px 10px;
  }

  .kind :global(svg) {
    color: var(--color-primary-ink);
  }

  .kind span {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-size: 14px;
    text-box: trim-end cap alphabetic;
  }

  #privacy {
    padding-block: calc(var(--section-space) * 0.5);
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: var(--heading-space);
  }

  .privacy .lead {
    margin: 0;
  }

  @media (max-width: 760px) {
    .wide-only {
      display: none;
    }
  }

  .privacy-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-primary);
  }

  .download-inner > :global(.platforms) {
    margin-top: var(--heading-space);
  }

  .release {
    margin: calc(var(--heading-space) * 0.5) 0 0;
    color: var(--color-text-muted);
    font-size: 14px;
    text-box: trim-both cap alphabetic;
  }

  .license {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease;
  }

  .license:hover {
    text-decoration-color: currentColor;
  }
</style>
