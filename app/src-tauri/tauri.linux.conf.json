{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/build-gstreamer.mjs",
    "runner": "../scripts/cargo.sh"
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "resources": {
      "runtime/onnxruntime/lib/libonnxruntime.so.1": "onnxruntime/libonnxruntime.so.1",
      "runtime/onnxruntime/LICENSE-onnxruntime.txt": "onnxruntime/LICENSE-onnxruntime.txt",
      "runtime/onnxruntime/ThirdPartyNotices-onnxruntime.txt": "onnxruntime/ThirdPartyNotices-onnxruntime.txt"
    },
    "category": "Utility",
    "shortDescription": "Find anything in your files",
    "longDescription": "Find anything in your files using any combination of clues: text, images, sounds, dates, and more.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/doc/gstreamer1.0-plugins-base/copyright": "/usr/share/doc/gstreamer1.0-plugins-base/copyright",
          "/usr/share/doc/gstreamer1.0-plugins-good/copyright": "/usr/share/doc/gstreamer1.0-plugins-good/copyright",
          "/usr/share/doc/gstreamer1.0-plugins-bad/copyright": "/usr/share/doc/gstreamer1.0-plugins-bad/copyright",
          "/usr/share/doc/gstreamer1.0-plugins-ugly/copyright": "/usr/share/doc/gstreamer1.0-plugins-ugly/copyright",
          "/usr/share/doc/gstreamer1.0-gl/copyright": "/usr/share/doc/gstreamer1.0-gl/copyright",
          "/usr/share/doc/gstreamer1.0-alsa/copyright": "/usr/share/doc/gstreamer1.0-alsa/copyright",
          "/usr/share/doc/libgstreamer-plugins-bad1.0-0/copyright": "/usr/share/doc/libgstreamer-plugins-bad1.0-0/copyright"
        }
      },
      "deb": {
        "depends": [
          "libheif1",
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "libvulkan1",
          "mesa-vulkan-drivers",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "libheif",
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "vulkan-loader",
          "mesa-vulkan-drivers",
          "gstreamer1-plugin-libav"
        ]
      }
    }
  }
}
