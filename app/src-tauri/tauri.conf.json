{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa",
  "version": "0.1.1",
  "identifier": "com.mesa.desktop",
  "build": {
    "beforeDevCommand": "npm run build:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Mesa",
        "width": 1080,
        "height": 635,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Mesa Search",
        "width": 992,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "runtime/llama/**/*": "llama/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/Assets.car"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MDEwNENGMzdDMTFEQzcKUldUSEhjRTN6d1FCOTNCR2VIZ1k3T00zVWlYNzBVeitVNXVlZHlTNVNwWUNvMkEvZWJEOTNtL3oK",
      "endpoints": ["https://github.com/biantsh/mesa/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
